# CypherBuddy Production & Local Development Environment Template
# Copy this file to .env and populate with actual secrets. NEVER commit .env to version control!

# MongoDB Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=cypherbuddy

# JWT Authentication Secrets
JWT_SECRET=YOUR_64_CHAR_RANDOM_HMAC_SECRET_KEY_HERE
JWT_ACCESS_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=30
# Where users/scan history are saved when MONGODB_URI is NOT set (default backend/data)
DATA_DIR=
JWT_REFRESH_SECRET=YOUR_64_CHAR_REFRESH_SECRET_KEY_HERE

# SMS / Email OTP Provider Configuration (mock | twilio | fast2sms | msg91 | smtp)
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret
SMS_SENDER_ID=CYPHER

# Admin account (created ONLY if ADMIN_PASSWORD is set - there are no built-in default credentials)
ADMIN_EMAIL=admin@yourdomain.example
ADMIN_PHONE=+91XXXXXXXXXX
ADMIN_PASSWORD=ChangeThisToALongRandomSecret

# Local development ONLY. Never enable in production: it makes OTP 123456 valid for the admin login.
ALLOW_DEV_OTP=false
SEED_DEMO_USER=false

# Cross-Origin & Domain URLs
FRONTEND_URL=https://cypherbuddy-opal.vercel.app
BACKEND_URL=https://cypherbuddy-backend.onrender.com
VITE_API_BASE_URL=https://cypherbuddy-backend.onrender.com
