# CypherBuddy Production & Local Development Environment Template
# Copy this file to .env and populate with actual secrets. NEVER commit .env to version control!

# MongoDB Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=cypherbuddy

# JWT Authentication Secrets
JWT_SECRET=YOUR_64_CHAR_RANDOM_HMAC_SECRET_KEY_HERE
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_SECRET=YOUR_64_CHAR_REFRESH_SECRET_KEY_HERE

# SMS / Email OTP Provider Configuration (mock | twilio | fast2sms | msg91 | smtp)
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret
SMS_SENDER_ID=CYPHER

# Official Prebuilt Admin Initial Credentials (Used during DB Seed if no admin exists)
ADMIN_PHONE=+917349107584
ADMIN_EMAIL=admin@cypherbuddy.org

ADMIN_PASSWORD=ChangeThisAdminSecret123!

# Cross-Origin & Domain URLs
FRONTEND_URL=https://cypherbuddy.vercel.app
BACKEND_URL=https://cypherbuddy-backend.onrender.com
VITE_API_BASE_URL=https://cypherbuddy-backend.onrender.com
